+  const timingFunction = /^(?:cubic-bezier|steps|linear|var)\(.+\)$/;
+  const time = /^(?:0|[+-]?(?:\d*\.\d+|\d+\.?\d*)(?:ms|s))$/;
+
+  const properties = transitions.map((transition) => {
